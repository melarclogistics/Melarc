# Dependencies
node_modules/
.pnpm-store/

# Build output
dist/
build/
out/
.turbo/
.vite/
.next/

# Written by CI (scripts/ci-revision.ts manifest) to describe the build it kept
/build-manifest.json

# Test and coverage output
coverage/
.nyc_output/
playwright-report/
test-results/
blob-report/

# Logs
*.log
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*
yarn-error.log*

# Environment and secrets
.env
.env.*
!.env.example
!.env.*.example
*.pem
*.key
*.p12
*.pfx
# Signing keys and service files of the mobile builds (Android keystores, Apple auth keys, Firebase settings)
*.jks
*.keystore
*.p8
google-services.json
GoogleService-Info.plist
# PostgreSQL password files
.pgpass
pgpass.conf

# Local databases and runtime data
*.sqlite
*.sqlite3
*.db
# Database dumps (pg_dump -Fc and friends): data, never source. Migrations are .sql files and stay tracked.
*.dump
.local-data/
tmp/
temp/

# IDE and operating-system files
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.DS_Store
Thumbs.db
Desktop.ini

# Local agent/session scratch
.claude/
.superpowers/

# Local archives and scratch exports
*.zip
*.tar
*.tar.gz
*.7z