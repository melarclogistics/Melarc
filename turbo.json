{
  "$schema": "./node_modules/turbo/schema.json",
  "agentGuidance": false,
  "globalDependencies": [
    "contracts/openapi.yaml",
    "tsconfig.base.json",
    "pnpm-workspace.yaml",
    ".node-version"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "typecheck": {},
    "lint": {
      "dependsOn": ["^lint"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/eslint.config.mjs",
        "$TURBO_ROOT$/tsconfig.base.json",
        "$TURBO_ROOT$/contracts/openapi.yaml"
      ],
      "outputs": []
    },
    "test": {
      "passThroughEnv": ["MELARC_TEST_WORKERS"]
    },
    "test:db": {
      "cache": false,
      "passThroughEnv": [
        "MELARC_TEST_WORKERS",
        "MELARC_DB_WORKERS",
        "MELARC_DB_SHARD",
        "MELARC_SKIP_TIMING_TESTS",
        "JAVA_HOME",
        "MELARC_PG_HOST",
        "MELARC_PG_PORT",
        "MELARC_PG_ADMIN_PASSWORD",
        "MELARC_PG_MIGRATION_PASSWORD",
        "MELARC_PG_RUNTIME_PASSWORD"
      ]
    },
    "test:e2e": {
      "cache": false,
      "dependsOn": ["@melarc/api#build", "@melarc/ops-web#build"],
      "passThroughEnv": [
        "MELARC_PG_HOST",
        "MELARC_PG_PORT",
        "MELARC_PG_ADMIN_PASSWORD",
        "MELARC_PG_MIGRATION_PASSWORD",
        "MELARC_PG_RUNTIME_PASSWORD",
        "PLAYWRIGHT_BROWSERS_PATH"
      ]
    },
    "test:e2e:https": {
      "cache": false,
      "dependsOn": ["@melarc/api#build", "@melarc/ops-web#build"],
      "passThroughEnv": [
        "MELARC_PG_HOST",
        "MELARC_PG_PORT",
        "MELARC_PG_ADMIN_PASSWORD",
        "MELARC_PG_MIGRATION_PASSWORD",
        "MELARC_PG_RUNTIME_PASSWORD",
        "PLAYWRIGHT_BROWSERS_PATH",
        "CI",
        "GITHUB_ACTIONS",
        "RUNNER_ENVIRONMENT",
        "MELARC_E2E_KEYS_CLEARED",
        "MELARC_HTTPS_SHARD",
        "MELARC_WEBKIT_HEADED",
        "OPENSSL",
        "CERTUTIL"
      ]
    },
    "test:browser": {
      "cache": false,
      "passThroughEnv": [
        "PLAYWRIGHT_BROWSERS_PATH",
        "MELARC_BROWSERS",
        "MELARC_BROWSER_SHARD",
        "MELARC_WEBKIT_HEADED"
      ]
    }
  }
}
