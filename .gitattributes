# Normalize text files in the new development repository.
* text=auto eol=lf

# Windows command scripts may retain CRLF where required.
*.bat text eol=crlf
*.cmd text eol=crlf

# Generated API client: collapsed in reviews. Regenerate it, never edit it (pnpm run api-client:generate).
packages/api-client/src/generated/** linguist-generated=true

# Binary assets
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.pdf binary
*.zip binary
*.gz binary
*.7z binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary