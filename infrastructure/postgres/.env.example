# Settings for the local PostgreSQL service and the database tests (B0.4). Copy this file to .env and
# replace every CHANGE_ME with a long random value (`pnpm run setup:env` does exactly that, and never overwrites).
# .env is git-ignored. These are throwaway credentials for a database on your own machine; nothing
# here is used in staging or production, where credentials come from the secret store.

# Where the service listens. It is published on loopback only. Use another port (5433, say) if something
# else on this machine already holds 5432: the tools must never be pointed at a server that is not this one.
MELARC_PG_HOST=127.0.0.1
MELARC_PG_PORT=5432

# The cluster superuser (user "postgres"). Used only by the local provisioning and the database tests
# to create roles and disposable databases. The API never connects with it.
MELARC_PG_ADMIN_PASSWORD=CHANGE_ME

# Passwords for the two login roles the local provisioning creates (SECURITY_DESIGN.md section 14.6):
# the deployment-window migration identity and the API runtime identity. They must differ.
MELARC_PG_MIGRATION_PASSWORD=CHANGE_ME
MELARC_PG_RUNTIME_PASSWORD=CHANGE_ME
