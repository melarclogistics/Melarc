{
  "name": "@melarc/api-client",
  "version": "0.0.0",
  "private": true,
  "description": "Generated wire types for contracts/openapi.yaml and the browser transport that carries them.",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./browser": "./src/browser/index.ts"
  },
  "scripts": {
    "generate": "node scripts/generate.ts",
    "check": "node scripts/generate.ts --check",
    "typecheck": "tsc --project tsconfig.json",
    "lint": "node --max-old-space-size=1536 ../../node_modules/eslint/bin/eslint.js . --max-warnings 0",
    "test": "vitest run"
  },
  "dependencies": {
    "openapi-fetch": "0.17.0"
  },
  "devDependencies": {
    "@types/node": "24.19.1",
    "openapi-typescript": "7.13.0",
    "typescript": "6.0.3",
    "vitest": "5.0.3",
    "yaml": "2.9.1"
  }
}
