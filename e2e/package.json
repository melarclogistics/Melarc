{
  "name": "@melarc/e2e",
  "version": "0.0.0",
  "private": true,
  "description": "Integrated test harness: a real browser, the Ops build, the API process and a disposable PostgreSQL database.",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --project tsconfig.json",
    "lint": "node --max-old-space-size=1536 ../node_modules/eslint/bin/eslint.js . --max-warnings 0",
    "test": "vitest run",
    "test:e2e": "playwright test --project=chromium --project=chromium-secret",
    "test:e2e:https": "node harness/https-run.ts",
    "tls:generate": "node harness/test-ca-main.ts"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "24.19.1",
    "@types/pg": "8.23.1",
    "jsqr": "1.4.0",
    "pg": "8.23.1",
    "typescript": "6.0.3",
    "vitest": "5.0.3"
  }
}
