# The notification lane's real text messages (S1.12): Hubtel, inside a CONTROLLED WINDOW. Copy this file to apps/api/.env.sms (git-ignored)
# and fill it in yourself. The worker (`pnpm --filter @melarc/api run start:worker:local`) and the smoke command
# (`pnpm --filter @melarc/api run sms:smoke -- --to +233XXXXXXXXX`) load it after .env; the API never does, so Hubtel's credentials are
# never in the API's environment.
#
# Never put a credential anywhere else: not in .env.example, not in a chat, a log, a test or a commit. Use a separate or low-balance Hubtel
# credential if you can. The names below are the whole list (DEPLOYMENT_AND_ENVIRONMENTS.md, the delivery worker's table).
#
# The window is complete only when ALL FOUR of its settings are set, and it ends within 14 days of the worker's start. The worker refuses
# to start with the provider and any of them missing; it sends only to the numbers in the allow-list, never more than the cap in total,
# and never at or after the end. Renew a window with a NEW approval reference (it has a count of its own).

NOTIFICATION_SMS_ADAPTER=provider
# Hubtel's messages resource: the send is POST {endpoint}/send, the status check GET {endpoint}/{messageId}. Confirm with Hubtel's reference.
NOTIFICATION_SMS_ENDPOINT=https://smsc.hubtel.com/v1/messages
NOTIFICATION_SMS_TIMEOUT_MS=8000

# From the SMS API of your Hubtel account (a client id and a client secret, with a funded SMS balance and an approved sender ID).
HUBTEL_SMS_CLIENT_ID=
HUBTEL_SMS_CLIENT_SECRET=
# The sender ID registered with Hubtel: 3 to 11 letters or digits.
HUBTEL_SMS_SENDER_ID=Melarc

# The controlled window.
DELIVERY_PROVIDER_APPROVAL_REF=OWNER-2026-10-29-SMS
# The numbers you control, in the form +233XXXXXXXXX, comma-separated (1 to 50). A message to any other number is refused and nothing is sent.
DELIVERY_PROVIDER_ALLOWLIST=
# The most messages the window may send in total (1 to 1000), counted across restarts.
DELIVERY_PROVIDER_MESSAGE_CAP=20
# The moment the window ends, in UTC with a Z, after the worker starts and at most 14 days after it.
DELIVERY_PROVIDER_WINDOW_ENDS_AT=2026-11-05T23:59:59Z
