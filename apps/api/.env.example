# Melarc API configuration. Copy to .env for a local run and never commit .env.
# Load it with:  node --env-file=.env dist/main.js
#
# The API refuses to start, naming the key, when a required value is missing or invalid. Required keys
# have no default on purpose. Secrets never belong in this file: they come from the platform's secret
# store (DEPLOYMENT_AND_ENVIRONMENTS.md section 5).

# Framework mode. development | test | production. Required.
# Staging and production must run with production.
NODE_ENV=development

# The Melarc environment. local | staging | production. Required.
APP_ENV=local

# Where to listen. HTTP_PORT is required (1-65535). HTTP_HOST defaults to 127.0.0.1; deployments that
# sit behind the edge proxy set it explicitly.
HTTP_HOST=127.0.0.1
HTTP_PORT=3000

# fatal | error | warn | info | debug | trace | silent. Defaults to info.
LOG_LEVEL=info

# The API's database connection. Required. The API connects only as its runtime identity,
# melarc_api_runtime (SECURITY_DESIGN.md section 14.17); any other user is refused at startup. Locally the
# password is MELARC_PG_RUNTIME_PASSWORD from infrastructure/postgres/.env; elsewhere it comes from the
# secret store. DATABASE_POOL_MAX is the most connections the API keeps open (1-100, default 10).
# DATABASE_MIGRATION_URL must never be set for the API: it refuses to start if it is.
# The URL carries no query string or fragment (no ?user=, ?sslmode=, #...): the API refuses one rather than
# let it change the user, host or port that were checked. Connection options wait for the deployment design.
DATABASE_URL=postgres://melarc_api_runtime:CHANGE_ME@127.0.0.1:5432/melarc_dev
DATABASE_POOL_MAX=10

# Graceful shutdown. SHUTDOWN_TIMEOUT_MS is the one budget for the whole shutdown (1000-300000 ms,
# default 15000): the drain delay, finishing in-flight requests, the Nest shutdown hooks and closing
# registered resources all run inside it. When it runs out the process exits with code 1 without waiting
# for anything still stalled, so the platform's stop grace period must be longer than it.
# SHUTDOWN_DRAIN_DELAY_MS is how long to keep serving after readiness turns false so the load balancer
# stops sending traffic (0-60000 ms, default 0). It counts against the budget and must be shorter.
SHUTDOWN_TIMEOUT_MS=15000
SHUTDOWN_DRAIN_DELAY_MS=0
