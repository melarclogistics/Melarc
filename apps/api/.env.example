# Melarc API configuration. Copy to .env for a local run and never commit .env.
# Load it with:  node --env-file=.env dist/main.js
#
# The API refuses to start, naming the key, when a required value is missing or invalid. Required keys
# have no default on purpose. Secrets never belong in this file: they come from the platform's secret
# store (DEPLOYMENT_AND_ENVIRONMENTS.md section 5). The one exception is a local run, whose throwaway
# key material `pnpm run setup:env` generates into the untracked .env; this file holds only the placeholder.

# Framework mode. development | test | production. Required.
# Staging and production must run with production.
NODE_ENV=development

# The Melarc environment. local | staging | production. Required.
APP_ENV=local

# Where to listen. HTTP_PORT is required (1-65535). HTTP_HOST defaults to 127.0.0.1; deployments that
# sit behind the edge proxy set it explicitly.
HTTP_HOST=127.0.0.1
HTTP_PORT=3000

# fatal | error | warn | info | debug | trace | silent. Defaults to info.
LOG_LEVEL=info

# The API's database connection. Required. The API connects only as its runtime identity,
# melarc_api_runtime (SECURITY_DESIGN.md section 14.17); any other user is refused at startup. Locally the
# password is MELARC_PG_RUNTIME_PASSWORD from infrastructure/postgres/.env; elsewhere it comes from the
# secret store. DATABASE_POOL_MAX is the most connections the API keeps open (1-100, default 10).
# DATABASE_MIGRATION_URL and DATABASE_SEED_URL (the provisioning login the seed command uses) must never be set for the API: it
# refuses to start if either is.
# The URL carries no query string or fragment (no ?user=, ?sslmode=, #...): the API refuses one rather than
# let it change the user, host or port that were checked. Connection options wait for the deployment design.
DATABASE_URL=postgres://melarc_api_runtime:CHANGE_ME@127.0.0.1:5432/melarc_dev
DATABASE_POOL_MAX=10

# Graceful shutdown. SHUTDOWN_TIMEOUT_MS is the one budget for the whole shutdown (1000-300000 ms,
# default 15000): the drain delay, finishing in-flight requests, the Nest shutdown hooks and closing
# registered resources all run inside it. When it runs out the process exits with code 1 without waiting
# for anything still stalled, so the platform's stop grace period must be longer than it.
# SHUTDOWN_DRAIN_DELAY_MS is how long to keep serving after readiness turns false so the load balancer
# stops sending traffic (0-60000 ms, default 0). It counts against the budget and must be shorter.
SHUTDOWN_TIMEOUT_MS=15000
SHUTDOWN_DRAIN_DELAY_MS=0

# The browser origin of each surface, written exactly as a browser sends it in Origin: http or https, a host and
# an optional port, no path, query, fragment or trailing slash (SECURITY_DESIGN.md section 14.8). Required, with no
# default, and different from each other. Anything but a local run needs https. The setup and recovery links are
# built from these: the page each surface owns, with the token in the fragment.
OPS_ORIGIN=http://127.0.0.1:5172
VENDOR_ORIGIN=http://127.0.0.1:5174

# Transport (DEPLOYMENT_AND_ENVIRONMENTS.md sections 12.2 and 12.5). HTTP_TRUST_PROXY is off, or the trusted hops
# by address (up to 16, comma-separated): never a count, true or a wildcard. The loader checks the bounds of the limits
# and deadlines below; S0.20 (transport admission) applies them and its tests exercise these values, which are
# development-qualified, not production-qualified (section 12.5); S0.65 calibrates them. The header and body
# deadlines are receipt limits (how long the server waits for a client to send); they do not bound a handler's execution.
HTTP_TRUST_PROXY=off
HTTP_BODY_LIMIT_BYTES=102400
HTTP_HEADER_TIMEOUT_MS=10000
HTTP_BODY_TIMEOUT_MS=10000
HTTP_ADMISSION_TIMEOUT_MS=2000
HTTP_ADMISSION_CONCURRENCY=64

# Database deadlines (SECURITY_DESIGN.md section 14.6), in milliseconds. They nest: the lock wait must be less than the
# statement time, which must be less than the transaction time. That nesting is all the loader checks; S0.6 (resource
# deadlines) applies the values to the pool and the connections and qualified them (section 12.5).
DATABASE_ACQUIRE_TIMEOUT_MS=5000
DATABASE_LOCK_TIMEOUT_MS=2000
DATABASE_STATEMENT_TIMEOUT_MS=5000
DATABASE_IDLE_IN_TRANSACTION_TIMEOUT_MS=5000
DATABASE_TRANSACTION_TIMEOUT_MS=10000
DATABASE_POOL_MAX_WAITERS=50

# The request execution budget, in milliseconds (plan section 11.8): the longest one request may run once received and
# admitted, database work and everything else included. S0.6 (resource deadlines) built the mechanism and the database
# layer consumes it; S0.20 (transport admission) puts one around every request.
REQUEST_EXECUTION_BUDGET_MS=15000

# The request limiter (SECURITY_DESIGN.md section 14.12). postgres is the authoritative one. memory is for a local run
# only: staging and production refuse it.
RATE_LIMITER=postgres

# Key custody (SECURITY_DESIGN.md section 14.9). local is the only custody built: the key material below comes from this
# environment, which is a substitute and not KMS-backed custody, so production refuses it. There is no production custody
# yet, so a production start is refused until one is built (a prerequisite of release gate G3, not of the identity slice).
# Staging may use it for controlled fixture acceptance only: that is not real-secret or release evidence.
KEY_CUSTODY=local

# One key set per purpose, each with its own version: totp_seed, credential_delivery, idempotent_replay, limiter_digest
# and password_pepper. MATERIAL lists the versions this deployment holds as <version>:<key>, comma-separated (one to
# eight; an old version stays only for the records it must open). A key is 32 random bytes as 43 unpadded base64url
# characters, and no key may be used twice, in any purpose or version. ACTIVE_VERSION is the version new records are
# written under and must be one of those listed. `pnpm run setup:env` replaces each CHANGE_ME below with a fresh key in
# the untracked .env; never put a real key in this file.
KEY_TOTP_SEED_MATERIAL=1:CHANGE_ME
KEY_TOTP_SEED_ACTIVE_VERSION=1
KEY_CREDENTIAL_DELIVERY_MATERIAL=1:CHANGE_ME
KEY_CREDENTIAL_DELIVERY_ACTIVE_VERSION=1
KEY_IDEMPOTENT_REPLAY_MATERIAL=1:CHANGE_ME
KEY_IDEMPOTENT_REPLAY_ACTIVE_VERSION=1
KEY_LIMITER_DIGEST_MATERIAL=1:CHANGE_ME
KEY_LIMITER_DIGEST_ACTIVE_VERSION=1
KEY_PASSWORD_PEPPER_MATERIAL=1:CHANGE_ME
KEY_PASSWORD_PEPPER_ACTIVE_VERSION=1

# Credential hashing (SECURITY_DESIGN.md sections 13.4 and 13.4c). ARGON2_* is the Argon2id profile new hashes are written at:
# memory in KiB (at least 8 and a multiple of 4 per lane, at most 1048576), passes (1-16) and lanes (1-16). The values below are
# the development-qualified profile, 64 MiB, 2 passes and 1 lane, measured on one development machine and NOT production-qualified;
# S0.65 proposes the release profile. Staging and production refuse less than 19456 KiB or fewer than 2 passes. A hash is verified
# at the profile it was made with, so ARGON2_ACCEPTED_PROFILES lists the older profiles stored hashes may still be verified at, as
# <memory KiB>:<passes>:<lanes>, comma-separated (up to eight, none repeated, none the profile above); a hash at any other profile
# is refused without being derived. A stored hash is only ever rewritten forward, to a larger cost or a newer pepper. Validated at
# start; the Hasher is given them by the task that binds it.
ARGON2_MEMORY_KIB=65536
ARGON2_PASSES=2
ARGON2_PARALLELISM=1
# ARGON2_ACCEPTED_PROFILES=19456:2:1
# Hash admission (SECURITY_DESIGN.md section 13.4c): the most password hashes that run at once, and the memory they may take together in
# MiB. A hash that finds every slot taken is refused at once, with nothing verified and nothing counted. The slots are held below the
# libuv pool the process has (4 by default; UV_THREADPOOL_SIZE) so that hashing never takes every thread, and the slots, each at the
# largest profile that may be derived (the write profile and every accepted one), must fit the budget. Development-qualified,
# not production-qualified.
HASH_ADMISSION_SLOTS=2
HASH_ADMISSION_MEMORY_BUDGET_MIB=256

# Credential and recovery message delivery (SECURITY_DESIGN.md section 13.9a). capture is the non-production sink, which
# holds a message in clear by design: production refuses it, and staging may use it for controlled fixture acceptance
# only, never as real-provider evidence. A local run (APP_ENV=local), and CI, which runs as one, uses capture only: provider
# is refused there. provider is a configured production adapter (or a staging one inside the controlled window), which needs
# its endpoint (https, with no user information, query or fragment) and its timeout in milliseconds (100-60000); with
# capture they must be absent. No provider has been selected, so none is named here.
DELIVERY_EMAIL_ADAPTER=capture
DELIVERY_SMS_ADAPTER=capture
# DELIVERY_EMAIL_ENDPOINT=https://email-provider.example/v1
# DELIVERY_EMAIL_TIMEOUT_MS=5000
# DELIVERY_SMS_ENDPOINT=https://sms-provider.example/v1
# DELIVERY_SMS_TIMEOUT_MS=5000

# The rider device attestation verifier (SECURITY_DESIGN.md section 15.2.3). substitute is the deterministic
# non-production one: production refuses it, and staging may use it for controlled fixture acceptance only. service is
# the private verifier service (apps/attestation-verifier), which needs its URL and timeout and a caller secret of the same form as a
# key (required in production, and wherever the URL is not on a loopback host). They must be absent with substitute. The trust roots,
# package name, signing digests and trust-data age are the verifier's own settings (apps/attestation-verifier/.env.example), not this
# file's. To use the real service locally: `pnpm run verifier:start`, then set service, http://127.0.0.1:8765, a timeout and the secret
# the verifier was given as VERIFIER_CALLER_SECRET.
ATTESTATION_VERIFIER=substitute
# ATTESTATION_VERIFIER_URL=https://verifier.internal.example
# ATTESTATION_VERIFIER_TIMEOUT_MS=3000
# ATTESTATION_VERIFIER_CALLER_SECRET=a-32-byte-key-as-43-base64url-characters

# The object store of the evidence records (DEPLOYMENT_AND_ENVIRONMENTS.md section 12.5, S1.11): in-process (a stand-in that keeps objects in the
# process's memory and reaches no bucket: a local run and CI; production refuses it) or r2 (Cloudflare R2, the owner's choice of 29 October 2026).
# No bucket exists yet. The four EVIDENCE_R2_* settings are required with r2 and absent with in-process; the secret is the owner's alone and is
# never written in a chat, a log, a test or a commit.
EVIDENCE_STORE=in-process
# EVIDENCE_R2_ACCOUNT_ID=
# EVIDENCE_R2_BUCKET=
# EVIDENCE_R2_ACCESS_KEY_ID=
# EVIDENCE_R2_SECRET_ACCESS_KEY=

# The malicious-content check of an uploaded object (DEPLOYMENT_AND_ENVIRONMENTS.md section 12.5 and the release gate; SECURITY_DESIGN.md section 14.18b; Run A2, D-A6):
# in-process (a stand-in that flags the EICAR test file and calls everything else clean: a local run and CI; production refuses it) or clamav (the ClamAV daemon, clamd,
# over TCP). **A record of evidence becomes STORED only on a clean verdict.** Left out (as here), production starts with no scanner and refuses to store any
# evidence until one is configured, and any other environment gets in-process. The three EVIDENCE_CLAMAV_* settings are required with clamav and absent
# otherwise: the daemon's host and port (reachable by the API only, on a private network: clamd has no authentication) and how long one scan may take, which must
# be shorter than REQUEST_EXECUTION_BUDGET_MS.
# EVIDENCE_SCANNER=clamav
# EVIDENCE_CLAMAV_HOST=clamav.internal.example
# EVIDENCE_CLAMAV_PORT=3310
# EVIDENCE_CLAMAV_TIMEOUT_MS=10000

# The private metrics endpoint (DEPLOYMENT_AND_ENVIRONMENTS.md section 12.5, "Metrics"): a listener of its own that answers only
# GET /metrics, in the Prometheus text format, and is never a route of the API. Off unless METRICS_PORT is set (not HTTP_PORT).
# METRICS_HOST is where it listens, the loopback address by default; anywhere else needs METRICS_SECRET, a key of the same form as
# the others, which every request must then carry as `Authorization: Bearer`. The delivery worker has its own three
# (DELIVERY_WORKER_METRICS_*, below), so the two processes never claim one port.
METRICS_HOST=127.0.0.1
# METRICS_PORT=9464
# METRICS_SECRET=a-32-byte-key-as-43-base64url-characters

# The delivery worker (S0.18; DEPLOYMENT_AND_ENVIRONMENTS.md sections 4.1 and 12.5). It is its own process, started with
# `pnpm --filter @melarc/api run start:worker:local`, and reads this file for the settings it shares with the API (NODE_ENV, APP_ENV,
# LOG_LEVEL, SHUTDOWN_TIMEOUT_MS, the DATABASE_* deadlines, KEY_CUSTODY, the credential_delivery key and the DELIVERY_* adapters
# above) and for the ones below. It holds the credential_delivery key and no other, and a deployed worker is refused an
# environment that carries the API's DATABASE_URL, the key of another purpose or ATTESTATION_VERIFIER_CALLER_SECRET.
# DATABASE_WORKER_URL is the worker's own login, melarc_worker_runtime (SECURITY_DESIGN.md section 14.17). Optional: a local run derives
# it from the local cluster's settings, as db:seed does. It is forbidden in the API's environment: the API refuses to start with it set.
# DATABASE_WORKER_URL=postgres://melarc_worker_runtime:CHANGE_ME@127.0.0.1:5432/melarc_dev
# DELIVERY_WORKER_CONCURRENCY is the most messages in flight at once (1-32), and DELIVERY_WORKER_POLL_INTERVAL_MS how long an idle
# lane waits before it looks for a due message again (100-60000 ms). Development-qualified, not production-qualified: S0.65 calibrates
# them.
DELIVERY_WORKER_CONCURRENCY=4
DELIVERY_WORKER_POLL_INTERVAL_MS=2000
# PICKUP_BACKSTOP_INTERVAL_MINUTES is how many minutes the failure backstop (S1.28, D-A1: a lane of this worker that escalates a pickup failure left
# undecided beyond its hub's stale_failure_backstop_hours) waits between its checks (1-1440). Required, and in no way a default of the code: the
# Product Owner decided 15 minutes in every environment, and the worker refuses to start without the key.
PICKUP_BACKSTOP_INTERVAL_MINUTES=15
# DELIVERY_CAPTURE_DIRECTORY is where the capture adapter writes each message, in clear and with its link: an absolute path outside the
# repository, in a folder only you can read. The worker refuses a folder inside the checkout. Required while a channel uses the capture
# adapter; a local run with none uses ~/.melarc/capture, and a deployed one (Staging) must name it.
# DELIVERY_CAPTURE_DIRECTORY=/home/you/.melarc/capture
# The controlled real-provider window (DEPLOYMENT_AND_ENVIRONMENTS.md section 4.1): in Staging a real provider is refused unless both
# are set, and with the capture adapter, and in production, both must be absent. No real provider is built for the credential channels
# (the worker refuses to select one); the notification lane's text messages may use Hubtel (below).
# DELIVERY_PROVIDER_APPROVAL_REF=G3-2026-001
# DELIVERY_PROVIDER_ALLOWLIST=staff@example.test,+233200000000
# The notification lane's text messages (S1.12) go through capture, the default, or through Hubtel. A real provider in a LOCAL run is a
# controlled window (DEPLOYMENT_AND_ENVIRONMENTS.md section 4.1, the Product Owner's decision of 29 October 2026): the approval reference
# and the allow-list above, and the two below (the most messages the window may send in total; the moment it ends, in UTC with a Z, at
# most 14 days after the worker starts). The worker refuses to start with the provider and any of the four missing. Hubtel's credentials
# are the owner's alone: keep them in apps/api/.env.sms (git-ignored; the worker and the smoke command load it, the API never does; the
# names are in apps/api/.env.sms.example), never in this file, a log, a test, a commit or a chat. Capture refuses all of these keys.
# NOTIFICATION_SMS_ADAPTER=capture
# NOTIFICATION_SMS_ENDPOINT=https://smsc.hubtel.com/v1/messages
# NOTIFICATION_SMS_TIMEOUT_MS=8000
# HUBTEL_SMS_CLIENT_ID=
# HUBTEL_SMS_CLIENT_SECRET=
# HUBTEL_SMS_SENDER_ID=Melarc
# DELIVERY_PROVIDER_MESSAGE_CAP=20
# DELIVERY_PROVIDER_WINDOW_ENDS_AT=2026-11-05T23:59:59Z
# The worker's own private metrics endpoint, by the rules of METRICS_* above and on a port of its own: GET /metrics with the delivery
# counters and the age of the oldest due message (the delivery-backlog alert's gauge). Off unless DELIVERY_WORKER_METRICS_PORT is set.
DELIVERY_WORKER_METRICS_HOST=127.0.0.1
# DELIVERY_WORKER_METRICS_PORT=9465
# DELIVERY_WORKER_METRICS_SECRET=a-32-byte-key-as-43-base64url-characters
