# Melarc Ops Portal (apps/ops-web) development settings. Copy to .env for a local run; never commit .env.
#
# The browser bundle sees only variables prefixed VITE_, and the build refuses any of those that look
# like secrets. Nothing below is bundled.

# Where the dev server forwards /api/v1, so the browser only ever talks to its own origin.
# Defaults to the API's local address (apps/api/.env.example).
OPS_API_PROXY_TARGET=http://127.0.0.1:3000
