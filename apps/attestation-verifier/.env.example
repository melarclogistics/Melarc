# The settings of the private attestation verifier (apps/attestation-verifier/CLAUDE.md). Copy this file to `.env` in this folder (git-ignored)
# and fill in the three release inputs below: `pnpm run verifier:start` reads it, and the service refuses to start on a setting that is wrong,
# naming the setting and what it needs and never the value. Nothing here is a default for a release input: the package, the signing
# digests and the accepted roots are G3 inputs of the Product Owner, and a verifier started without them says so.
#
# Every value in this file is for a developer machine. The deployed values, and what production refuses, are in
# architecture/DEPLOYMENT_AND_ENVIRONMENTS.md (section 12.5).

VERIFIER_ENVIRONMENT=local

# Where it listens. Loopback needs no secret; any other address, and production, requires VERIFIER_CALLER_SECRET.
VERIFIER_BIND_ADDRESS=127.0.0.1
VERIFIER_PORT=8765

# What the API presents as `Authorization: Bearer`: 32 random bytes in their one base64url spelling, 43 characters, no padding.
# The API holds the same text as ATTESTATION_VERIFIER_CALLER_SECRET. Never commit it, never log it.
VERIFIER_CALLER_SECRET=

# The one package the Melarc Rider app is installed as (an Android package name such as a.b.c).
VERIFIER_PACKAGE_NAME=

# The SHA-256 digests (64 hexadecimal characters each, comma separated, at most ten) of the signing certificates of the release build.
# More than one is how a certificate is rotated. A debug signer goes in the second setting, which production refuses to start with.
VERIFIER_SIGNING_DIGESTS=
VERIFIER_DEBUG_SIGNING_DIGESTS=

# The accepted Android attestation roots: a file of a JSON array of PEM texts, read again when it changes. A relative path is relative to
# this folder. The default below is the list the pinned library ships (third_party/keyattestation/PROVENANCE.md).
VERIFIER_ACCEPTED_ROOTS_FILE=third_party/keyattestation/roots.json

# Google's attestation revocation list: one source, https (http only to loopback outside production), no redirect, a ceiling on its size.
VERIFIER_REVOCATION_URL=https://android.googleapis.com/attestation/status
VERIFIER_FETCH_TIMEOUT_MS=10000
VERIFIER_REVOCATION_MAX_BYTES=8388608

# How often the list is fetched (hours), how soon a failed fetch is retried (minutes), and how old the held list may be before every
# enrolment fails closed (hours: more than the refresh, 24 at most, and stated explicitly in production, where it must exceed 6).
VERIFIER_REFRESH_HOURS=6
VERIFIER_RETRY_MINUTES=15
VERIFIER_TRUST_DATA_MAX_AGE_HOURS=24

# Bounds on what one request may cost: the body (bytes), the verifications that run at once, and the time one may take (milliseconds).
VERIFIER_MAX_REQUEST_BYTES=65536
VERIFIER_MAX_CONCURRENT=8
VERIFIER_DEADLINE_MS=5000
